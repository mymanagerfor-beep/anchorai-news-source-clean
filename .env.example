# Copy to backend/.env and fill in. Never commit real secrets.
# --- Core ---
MONGO_URL="mongodb://localhost:27017"
DB_NAME="anchorai"
CORS_ORIGINS="https://your-app.example.com"
APP_URL="https://your-app.example.com"
API_PUBLIC_URL="https://api.your-app.example.com"
JWT_SECRET="replace-with-64-random-hex-chars"
SESSION_HOURS="12"

# --- Seeded platform admin ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# --- AI providers (fal.ai) ---
# fal_direct = your own FAL_KEY (self-hosting); universal = EMERGENT_LLM_KEY (Emergent platform only)
AI_PROVIDER_MODE="fal_direct"
FAL_KEY="your-fal-key"
EMERGENT_LLM_KEY=""
AVATAR_PROVIDER="fal_kling_v2_standard"
# AVATAR_API_BASE_URL / AVATAR_WEBHOOK_SECRET are not used: the proxy has fixed official endpoints and no app webhooks.

# --- Private file storage: local (server disk) or emergent ---
STORAGE_BACKEND="local"
LOCAL_STORAGE_DIR=""
STORAGE_PREFIX="anchorai"

# --- Email: smtp (cPanel mailbox), emergent, or none ---
EMAIL_BACKEND="smtp"
SMTP_HOST="mail.your-domain.com"
SMTP_PORT="465"
SMTP_SECURITY="ssl"
SMTP_USER="news@your-domain.com"
SMTP_PASSWORD=""
SMTP_FROM="news@your-domain.com"
EMERGENT_EMAIL_KEY=""
EMAIL_FROM_NAME="AnchorAI News"
EMAIL_REPLY_TO=""

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="xxxxxxxx"

# --- Temporary manual UPI payments (admin approves each payment) ---
MANUAL_UPI_ENABLED="1"
UPI_ID="yourname@bank"
UPI_PAYEE_NAME="Your Name"

# --- Pricing & limits ---
CREDITS_PER_SECOND="1"
MIN_CREDITS_PER_VIDEO="10"
RESERVE_BUFFER="0.15"
TRIAL_CREDITS="30"
MAX_NARRATION_SECONDS="60"
GU_CHARS_PER_SECOND="13"
MAX_UPLOAD_MB="10"
MIN_PORTRAIT_PX="512"

# --- Worker ---
RUN_WORKER="1"
